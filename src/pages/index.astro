---
// Accueil. Copy verbatim de 2026-08-28_JulienBrionne_Site-Accueil_v4.md,
// moins les prix (decisions.md, 28/08 au soir).
// L'édition de copy est close jusqu'au 31 octobre 2026 : ne pas retoucher un mot.
//
// Langage visuel, passe du 30/08 : un document éditorial, pas un portfolio.
// Aucun filet entre les sections, aucun ornement de rail. La hiérarchie vient
// de l'échelle typographique et de l'espace : dense à l'intérieur des blocs,
// généreux entre eux. L'accent est rarissime.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getPersonSchema, getWebsiteSchema, getServiceSchemas } from '../utils/schema';
import { EMAIL, mailto } from '../utils/mail';
import { MISE_AU_CLAIR, COPILOTE } from '../utils/offres';

// Objet générique, arbitré par Julien le 28/08. Les objets par offre vivent
// sur /ce-que-je-fais : ils sont la seule mesure de conversion par offre.
// Le corps de la lettre, lui, est commun — voir utils/mail.ts.
const MAILTO = mailto();

// Les six phrases de prospects. Nues : aucun titre, aucune introduction,
// aucun commentaire après. Accueil v4, section 2.
const phrases = ["On construit beaucoup et je ne sais pas si c'est la bonne chose.",
  'Aucun de mes PM ne peut prendre ce sujet transverse.',
  'Chaque client demande un truc différent et on dit oui à tout.',
  'La migration change de responsable tous les trois mois.',
  'Mes devs attendent que je décide et je n’ai pas le temps.',
  'Chaque équipe livre sa partie et le parcours reste cassé.',
];
---

<Layout
  title="Product Manager freelance : reprendre un sujet qui bloque"
  description="Un sujet produit important n'avance plus ? Senior Product Manager freelance, je le reprends avec vos équipes et je le mène jusqu'en production."
  ogTitle="Un sujet produit important n'avance plus ? Je le reprends et je le fais avancer."
  personSchema={getPersonSchema()}
  websiteSchema={getWebsiteSchema()}
  serviceSchemas={getServiceSchemas()}
  ogImage="/og/page-home.webp"
  twitterCard="summary_large_image"
>
  <Navbar current="accueil" />

  <main id="contenu" tabindex="-1">
    <!-- 1. Hero. Amendé le 30/08 sur décision de Julien, post-mise en prod :
         la promesse d'abord, l'accroche en second temps. Voir decisions.md.
         Le paysage du 14/09 est purement décoratif — aria-hidden, posé en
         fond CSS. Il met le portrait devant un horizon et s'éteint avant la
         colonne de texte ; s'il ne charge pas, la page ne change pas. -->
    <section class="hero px-6 pt-24 pb-24 sm:px-10 sm:pt-36 sm:pb-36">
      <div class="hero-scene" aria-hidden="true"></div>
      <div class="shell relative grid items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,17rem)] lg:gap-20">
        <div class="space-y-12 sm:space-y-16">
          <h1 class="reveal-load mise-au-point t-display max-w-[24ch] text-ink" style="--index:0">
            Un sujet produit important n’avance&nbsp;plus&nbsp;?
            <span class="text-dim italic">Je le reprends et je le fais avancer.</span>
          </h1>

          <div class="reveal-load measure-wide text-lg leading-relaxed text-ink sm:text-xl" style="--index:1">
            <p>
              Senior Product Manager freelance, j’interviens quand il faut enfin décider
              quoi construire, ou quand un sujet important n’arrive pas jusqu’en production.
            </p>
          </div>

          <p class="reveal-load" style="--index:2">
            <a href={MAILTO} class="door text-base sm:text-lg">
              <span>M’écrire</span>
              <span class="door-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </div>

        <img
          src="/portrait-640.webp"
          alt="Julien Brionne"
          width="427"
          height="640"
          fetchpriority="high"
          decoding="async"
          class="portrait-in mx-auto w-48 sm:w-56 lg:mx-0 lg:w-full"
        />
      </div>
    </section>

    <!-- 2. Reconnaissance. Un seul bloc de matière : six situations rapprochées,
         numéros en repère discret. Le lecteur doit se dire « c'est chez nous ». -->
    <section class="px-6 py-14 sm:px-10 sm:py-20">
      <div class="shell">
        <div class="measure-wide space-y-2.5">
          {phrases.map((phrase, i) => (
            <blockquote class="reveal" style={`--index:${i}`}>
              <p class="font-serif text-xl leading-snug text-ink sm:text-2xl">«&nbsp;{phrase}&nbsp;»</p>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Signature. Le moment fort de la page : trois lignes, grand corps,
         et l'accent sur la seule chose qui compte — le résultat.
         C'est le seul endroit du site où le mouvement porte le propos :
         les lignes se découvrent vers la droite au lieu de monter en fondu.
         Voir « L'AVANCÉE » dans global.css. La section, elle, ne bouge plus :
         elle laisserait son propre fondu se multiplier avec celui des lignes. -->
    <section class="px-6 py-28 sm:px-10 sm:py-44">
      <div class="shell space-y-2 sm:space-y-4">
        <p class="reveal avance t-display text-ink" style="--temps:0"><span>Je prends le sujet.</span></p>
        <p class="reveal avance t-display text-ink" style="--temps:180"><span>Je le fais avancer.</span></p>
        <p class="reveal avance t-display text-ochre" style="--temps:620"><span>Il sort.</span></p>
      </div>
    </section>

    <!-- 4. Le terrain. Deux faits, racontés comme des faits : le nom ouvre la
         phrase, le texte suit. Aucune carte, aucune décoration.
         Cadrage aligné le 18/09 sur celui de /ce-que-je-fais (ff7ab17) : la preuve
         n'est pas un palmarès de missions closes, c'est d'où viennent les deux
         offres. « Deux fois où ça a marché » racontait deux succès au passé ;
         le présent dit que la méthode est en exercice. -->
    <section class="px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell space-y-10 sm:space-y-12">
        <h2 class="t-title text-ink">Le terrain<span class="stop">.</span></h2>

        <p class="measure-wide text-lg leading-relaxed text-dim">
          Ce que je fais en mission, et d’où viennent les deux offres.
        </p>

        <div class="measure-wide space-y-8 text-lg leading-relaxed text-dim">
          <p>
            <strong class="font-semibold text-ink">Back Market.</strong>
            Un chantier téléphone ouvert depuis plus d’un an, en double run entre deux
            outils. Quatre mois après mon arrivée, les appels entrants passent en production
            sur quatre marchés en trois semaines. Première semaine en Allemagne :
            <span class="text-ink">100 % des appels décrochés.</span>
          </p>
          <p>
            <strong class="font-semibold text-ink">Heetch.</strong>
            Je fais supprimer la notation des chauffeurs à cinq étoiles, le standard du
            secteur, parce qu’elle mesurait autre chose que ce qu’elle annonçait. À la place :
            une qualification du problème et un parcours de résolution, contextualisés selon
            la course et le moyen de paiement. Cinq ans plus tard, la note est toujours
            absente de l’application.
            <span class="text-ink">Vous pouvez l’ouvrir et vérifier.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 5. Les deux situations. La Mise au clair domine, Le Copilote suit :
         la hiérarchie est dans l'échelle, pas dans des cadres. -->
    <section class="px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell space-y-10 sm:space-y-14">
        <h2 class="t-title max-w-[24ch] text-ink">
          Quand un sujet produit n’avance plus, c’est pour l’une de ces deux raisons<span class="stop">.</span>
        </h2>

        <article class="reveal measure-wide space-y-4">
          <h3 class="t-title text-ink">Vous ne savez plus quoi décider.</h3>
          <p class="text-lg leading-relaxed text-dim">
            Vous construisez déjà. Les demandes s’accumulent, tout paraît urgent, et vos
            équipes attendent que vous tranchiez.
          </p>

          <div class="space-y-2.5 pt-3">
            <p class="text-lg font-semibold text-ink">La Mise au clair</p>
            <p class="leading-relaxed text-dim">
              {MISE_AU_CLAIR.format}. À la fin : une décision prise avec vous,
              le cadre écrit, les trois prochains mois séquencés. Parfois la décision
              est d’arrêter le sujet. C’est une issue, pas un échec.
            </p>
            <p class="leading-relaxed text-dim">
              Pas si vous cherchez quelqu’un pour dérouler une roadmap déjà écrite.
            </p>
            <p class="pt-1">
              <a href="/ce-que-je-fais#la-mise-au-clair" class="door text-base">
                <span>Voir La Mise au clair</span>
                <span class="door-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </p>
          </div>
        </article>

        <article class="reveal measure-wide space-y-4">
          <h3 class="t-title text-ink">Vous savez quoi faire, mais ça ne sort pas.</h3>
          <p class="text-lg leading-relaxed text-dim">
            Un sujet important traverse plusieurs équipes. Chacune livre sa partie, les
            arbitrages reviennent, le responsable change, la production recule.
          </p>

          <div class="space-y-2.5 pt-3">
            <p class="font-semibold text-ink">Le Copilote</p>
            <p class="leading-relaxed text-dim">
              {COPILOTE.format} pour faire sortir un MVP qui ne sort pas, avec la
              méthode que l’équipe garde après mon départ.
            </p>
            <p class="leading-relaxed text-dim">
              Pas si l’équipe ne sait pas encore quoi construire — c’est La Mise au clair.
            </p>
            <p class="pt-1">
              <a href="/ce-que-je-fais#le-copilote" class="door text-base">
                <span>Voir Le Copilote</span>
                <span class="door-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </p>
          </div>
        </article>

      </div>
    </section>

    <!-- 6. Comment ça commence. Un titre, trois lignes, une porte. -->
    <section class="px-6 py-20 pb-28 sm:px-10 sm:py-28 sm:pb-40">
      <div class="shell space-y-8">
        <h2 class="t-title text-ink">Comment ça commence<span class="stop">.</span></h2>

        <div class="measure-wide space-y-5 text-lg leading-relaxed text-dim">
          <p>
            Écrivez-moi. Trois choses suffisent : ce qui n’avance pas, depuis combien de
            temps, et qui peut trancher chez vous.
          </p>
          <p>Je vous réponds et je vous dis si c’est pour moi ou pas.</p>
        </div>

        <div class="space-y-3 pt-2">
          <p>
            <a href={MAILTO} class="door font-serif text-xl sm:text-2xl">
              <span>M’écrire</span>
              <span class="door-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </p>
          <p class="text-sm text-dim">{EMAIL}</p>
        </div>
      </div>
    </section>
  </main>

  <Footer missionLongue={true} />
</Layout>
