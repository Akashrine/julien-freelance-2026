---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Posture from '../components/Posture.astro';
import Situations from '../components/Situations.astro';
import HomeCTA from '../components/HomeCTA.astro';
import Footer from '../components/Footer.astro';
import { getPersonSchema, getWebsiteSchema, getServiceSchemas } from '../utils/schema';

const personSchema = getPersonSchema();
const websiteSchema = getWebsiteSchema();
const serviceSchemas = getServiceSchemas();
---

<Layout
  title="Senior PM Freelance — Julien Brionne | Orga Produit"
  description="Senior PM Freelance, 10+ ans. J'interviens quand l'orga produit ne suit plus la croissance. Heetch, Back Market, Waalaxy, Wizville, et du conseil stratégique auprès de CEOs."
  ogTitle="Senior PM Freelance — Julien Brionne | Orga Produit"
  ogDescription="Senior PM Freelance, 10+ ans. J'interviens quand l'orga produit ne suit plus la croissance. Heetch, Back Market, Waalaxy, Wizville, et du conseil stratégique auprès de CEOs."
  ogType="website"
  ogImage="/og/page-home.webp"
  ogUrl="https://julien-brionne.fr"
  twitterCard="summary_large_image"
  twitterTitle="Senior PM Freelance — Julien Brionne | Orga Produit"
  twitterDescription="Senior PM Freelance, 10+ ans. J'interviens quand l'orga produit ne suit plus la croissance. Heetch, Back Market, Waalaxy, Wizville."
  personSchema={personSchema}
  websiteSchema={websiteSchema}
  serviceSchemas={serviceSchemas}
>
  <Navbar currentPage="home" />
  <main>
    <Hero />
    <Intro />
    <Posture />
    <Situations />
    <HomeCTA />
    <Footer />
  </main>
</Layout>
