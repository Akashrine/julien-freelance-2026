---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Section from '../../components/articles/Section.astro';
import SectionIntro from '../../components/articles/SectionIntro.astro';
import ColorBlock from '../../components/articles/ColorBlock.astro';
import DecisionItem from '../../components/articles/DecisionItem.astro';
import ClosingBlock from '../../components/articles/ClosingBlock.astro';
import SidebarBox from '../../components/articles/SidebarBox.astro';
import PillarCard from '../../components/articles/PillarCard.astro';
import Callout from '../../components/articles/Callout.astro';
import KeyPoint from '../../components/articles/KeyPoint.astro';
import CodeBlock from '../../components/articles/CodeBlock.astro';
import Tooltip from '../../components/Tooltip.astro';
import ArticleNavigation from '../../components/articles/ArticleNavigation.astro';
import ArticleMetadata from '../../components/articles/ArticleMetadata.astro';
import TableOfContents from '../../components/articles/TableOfContents.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getArticleSchema, getBreadcrumbSchema, BreadcrumbItems } from '../../utils/schema';
import { calculateReadingTime, extractHeadingsFromMDX } from '../../utils/articles';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => {
    return data.draft !== true;
  });

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

// Récupérer tous les articles pour la navigation
const allArticles = await getCollection('articles', ({ data }) => {
  return data.draft !== true;
});

// Trier par date décroissante
const sortedArticles = allArticles.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// Trouver l'index de l'article actuel
const currentIndex = sortedArticles.findIndex(a => a.slug === article.slug);

// Trouver l'article précédent et suivant
const previousArticle = currentIndex > 0 ? {
  slug: sortedArticles[currentIndex - 1].slug,
  title: sortedArticles[currentIndex - 1].data.title
} : null;

const nextArticle = currentIndex < sortedArticles.length - 1 ? {
  slug: sortedArticles[currentIndex + 1].slug,
  title: sortedArticles[currentIndex + 1].data.title
} : null;

// Render the MDX content
const { Content, remarkPluginFrontmatter } = await article.render();

const readingTime = calculateReadingTime(article.body || '');
const wordCount = (article.body || '').trim().split(/\s+/).length;
const tocHeadings = wordCount > 1500 ? extractHeadingsFromMDX(article.body || '') : [];

const siteUrl = 'https://www.julien-brionne.fr';
const articleUrl = `${siteUrl}/articles/${article.slug}`;

const rawExcerpt = article.data.excerpt || '';
const metaDescription = rawExcerpt.length > 155
  ? rawExcerpt.slice(0, 155).replace(/\s+\S*$/, '') + '\u2026'
  : rawExcerpt;

const ogImage = `/og/article-${article.slug}.webp`;
const twitterCard = 'summary_large_image';

// Generate article schema using utility function
const articleSchema = getArticleSchema(
  articleUrl,
  article.data.title,
  article.data.excerpt,
  article.data.date,
  article.data.date, // dateModified defaults to datePublished
  undefined, // about - can be added per article if needed
  article.data.thumbnail
);

// Generate extra schemas (FAQ, HowTo) for specific articles

// Generate breadcrumb schema
const breadcrumbSchema = getBreadcrumbSchema([
  BreadcrumbItems.home,
  BreadcrumbItems.articles,
  BreadcrumbItems.article(article.data.title, articleUrl),
]);
---

<Layout
  title={`${article.data.title} — Julien Brionne`}
  description={metaDescription}
  ogTitle={article.data.title}
  ogDescription={metaDescription}
  ogType="article"
  ogImage={ogImage}
  ogUrl={articleUrl}
  twitterCard={twitterCard}
  twitterTitle={article.data.title}
  twitterDescription={metaDescription}
  articleSchema={articleSchema}
  breadcrumbSchema={breadcrumbSchema}
  articleDate={article.data.date}
>
  <Navbar currentPage="articles" />
  <Breadcrumb items={[{ name: 'Accueil', url: '/' }, { name: 'Articles', url: '/articles' }, { name: article.data.title }]} />
  <main>
    <article class="max-w-[1150px] mx-auto px-8 py-20">
      <div class="max-w-3xl mx-auto mb-8">
        <div class="mb-6">
          <ArticleMetadata 
            date={article.data.date}
            category={article.data.category}
            readingTime={readingTime}
            variant="page"
          />
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif leading-tight mb-4">
          {article.data.title}
        </h1>
        <p class="font-mono text-[10px] text-gray-400 tracking-widest mb-8">
          Par Julien Brionne — Senior Product Manager freelance
        </p>
        <p class="text-xl text-gray-600 leading-relaxed font-light italic mb-4">
          {article.data.excerpt}
        </p>
      </div>

      {tocHeadings.length > 0 && (
        <div class="max-w-3xl mx-auto">
          <TableOfContents headings={tocHeadings} />
        </div>
      )}

      <div class="pt-8 border-t border-black/5">
        <Content components={{ Section, SectionIntro, ColorBlock, DecisionItem, ClosingBlock, SidebarBox, PillarCard, Callout, KeyPoint, CodeBlock, Tooltip }} />
      </div>

      <div class="max-w-3xl mx-auto">
        <ArticleNavigation previousArticle={previousArticle} nextArticle={nextArticle} />
        
        <div class="mt-8 pt-8 border-t border-black/5">
          <a href="/articles" class="back-link font-mono text-sm text-gray-500 hover:text-black transition-colors">
            Retour aux articles
          </a>
        </div>
      </div>
    </article>
    <Footer />
  </main>
</Layout>
