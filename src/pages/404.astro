---
// 404. Une ligne, une porte. noindex, hors sitemap par nature.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page introuvable — Julien Brionne"
  description="Cette page n'existe pas ou a été déplacée."
  noindex={true}
>
  <Navbar />

  <main id="contenu" tabindex="-1">
    <section class="px-6 pt-24 pb-24 sm:px-10 sm:pt-36 sm:pb-36">
      <div class="shell space-y-10">
        <h1 class="t-display max-w-[20ch] text-ink">
          Cette page n’existe pas<span class="stop">.</span>
        </h1>

        <p class="measure-wide text-lg leading-relaxed text-dim">
          Ou n’existe plus — plusieurs pages ont changé d’adresse cet été.
        </p>

        <p>
          <a href="/" class="door text-base sm:text-lg">
            <span>Retour à l’accueil</span>
            <span class="door-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
