---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page introuvable — Julien Brionne"
  description="Cette page n'existe pas ou a été déplacée."
  noindex={true}
>
  <Navbar />
  <main>
    <section class="max-w-[1150px] mx-auto px-8 py-40 text-center">
      <div class="font-mono mb-8 text-gray-400 tracking-[0.2em]">[ 404 ]</div>
      <h1 class="text-5xl md:text-6xl lg:text-7xl font-serif mb-8">
        Cette page <span class="italic text-gray-600">n'existe pas.</span>
      </h1>
      <p class="text-lg text-gray-500 font-light mb-12">
        L'URL est incorrecte ou le contenu a été déplacé.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="btn-cta font-mono tracking-widest text-[10px]">Retour à l'accueil</a>
        <a href="/articles" class="font-mono text-[10px] tracking-widest text-gray-600 border border-gray-300 px-8 py-4 hover:border-gray-600 hover:text-gray-900 transition-colors duration-200">
          Lire les articles
        </a>
      </div>
    </section>
    <Footer />
  </main>
</Layout>
