---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import DiagnosticIntro from '../components/DiagnosticIntro.astro';
import DiagnosticDefinition from '../components/DiagnosticDefinition.astro';
import DiagnosticLimits from '../components/DiagnosticLimits.astro';
import DiagnosticMethod from '../components/DiagnosticMethod.astro';
import DiagnosticResults from '../components/DiagnosticResults.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import { getWebPageSchema, getBreadcrumbSchema, BreadcrumbItems } from '../utils/schema';

const siteUrl = 'https://julien-brionne.fr';
const pageUrl = `${siteUrl}/diagnostic`;
const webPageSchema = getWebPageSchema(
  pageUrl,
  'Diagnostic de situation',
  'Intervention courte (2 à 3 semaines) pour identifier pourquoi les décisions ne tiennent pas, l\'adoption stagne et l\'impact recule malgré l\'effort. Aucune garantie de suite.',
  ['diagnostic produit', 'adoption stagne', 'décisions produit', 'impact produit']
);
const breadcrumbSchema = getBreadcrumbSchema([
  BreadcrumbItems.home,
  BreadcrumbItems.diagnostic,
]);
---

<Layout
  title="Diagnostic produit — Julien Brionne"
  description="L'effort augmente, l'impact ne suit plus ? Intervention courte 2 à 3 semaines pour identifier pourquoi les décisions ne tiennent pas. Diagnostic terrain."
  ogTitle="Diagnostic produit — Julien Brionne"
  ogDescription="L'effort augmente, l'impact ne suit plus ? Intervention courte pour identifier pourquoi les décisions ne tiennent pas."
  ogType="website"
  ogImage="/og/page-diagnostic.webp"
  ogUrl="https://julien-brionne.fr/diagnostic"
  twitterCard="summary_large_image"
  twitterTitle="Diagnostic produit — Julien Brionne"
  twitterDescription="L'effort augmente, l'impact ne suit plus ? Intervention courte pour identifier pourquoi les décisions ne tiennent pas."
  webPageSchema={webPageSchema}
  breadcrumbSchema={breadcrumbSchema}
>
  <Navbar currentPage="diagnostic" />
  <Breadcrumb items={[{ name: 'Accueil', url: '/' }, { name: 'Diagnostic' }]} />
  <main>
    <DiagnosticIntro />
    <DiagnosticDefinition />
    <DiagnosticLimits />
    <DiagnosticMethod />
    <DiagnosticResults />
    <section class="py-16 text-center">
      <p class="text-base text-gray-500 font-light">
        Prêt à en parler ? <a href="/contact" class="underline hover:text-gray-700 transition-colors">Prendre contact directement</a>.
      </p>
    </section>
    <Footer />
  </main>
</Layout>
