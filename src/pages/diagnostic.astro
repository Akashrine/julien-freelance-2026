---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import DiagnosticIntro from '../components/DiagnosticIntro.astro';
import DiagnosticDefinition from '../components/DiagnosticDefinition.astro';
import DiagnosticLimits from '../components/DiagnosticLimits.astro';
import DiagnosticMethod from '../components/DiagnosticMethod.astro';
import DiagnosticResults from '../components/DiagnosticResults.astro';
import Footer from '../components/Footer.astro';
import { getWebPageSchema, getBreadcrumbSchema, BreadcrumbItems } from '../utils/schema';

const siteUrl = 'https://julien-brionne.fr';
const pageUrl = `${siteUrl}/diagnostic`;
const webPageSchema = getWebPageSchema(
  pageUrl,
  'Diagnostic de situation',
  'Intervention courte (2–3 semaines) pour identifier pourquoi le care, le support ou les ops internes absorbent des ressources sans que la satisfaction ou l\'efficacité progresse. Aucune garantie de suite.',
  ['diagnostic ops', 'care produit', 'support efficiency', 'ops internes']
);
const breadcrumbSchema = getBreadcrumbSchema([
  BreadcrumbItems.home,
  BreadcrumbItems.diagnostic,
]);
---

<Layout
  title="Diagnostic care & ops — Julien Brionne"
  description="Intervention courte 2–3 semaines : pourquoi le care ou les ops absorbent des ressources sans progression. Diagnostic terrain, pas de conseil théorique."
  ogTitle="Diagnostic care & ops — Julien Brionne"
  ogDescription="Intervention courte 2–3 semaines : pourquoi le care ou les ops absorbent des ressources sans progression. Diagnostic terrain."
  ogType="website"
  ogImage="/og/page-diagnostic.webp"
  ogUrl="https://julien-brionne.fr/diagnostic"
  twitterCard="summary_large_image"
  twitterTitle="Diagnostic care & ops — Julien Brionne"
  twitterDescription="Intervention courte 2–3 semaines : pourquoi le care ou les ops absorbent des ressources sans progression. Diagnostic terrain."
  noindex={true}
  webPageSchema={webPageSchema}
  breadcrumbSchema={breadcrumbSchema}
>
  <Navbar currentPage="diagnostic" />
  <main>
    <DiagnosticIntro />
    <DiagnosticDefinition />
    <DiagnosticLimits />
    <DiagnosticMethod />
    <DiagnosticResults />
    <Footer />
  </main>
</Layout>
