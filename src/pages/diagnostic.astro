---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import DiagnosticIntro from '../components/DiagnosticIntro.astro';
import DiagnosticDefinition from '../components/DiagnosticDefinition.astro';
import DiagnosticLimits from '../components/DiagnosticLimits.astro';
import DiagnosticMethod from '../components/DiagnosticMethod.astro';
import DiagnosticResults from '../components/DiagnosticResults.astro';
import Footer from '../components/Footer.astro';
import { getWebPageSchema, getBreadcrumbSchema, BreadcrumbItems } from '../utils/schema';

const siteUrl = 'https://julien-brionne.fr';
const pageUrl = `${siteUrl}/diagnostic`;
const webPageSchema = getWebPageSchema(
  pageUrl,
  'Diagnostic de situation',
  'Intervention courte (2–3 semaines) pour identifier pourquoi les décisions ne tiennent pas. Mettre sur la table les tensions que personne n\'osait nommer, trancher en connaissance de cause. Aucune garantie de suite.',
  ['diagnostic de situation produit', 'trancher', 'décisions qui ne tiennent pas']
);
const breadcrumbSchema = getBreadcrumbSchema([
  BreadcrumbItems.home,
  BreadcrumbItems.diagnostic,
]);
---

<Layout
  title="Diagnostic de situation — Julien Brionne"
  description="Intervention courte (2–3 semaines) pour identifier pourquoi les décisions ne tiennent pas. Mettre sur la table les tensions que personne n'osait nommer, trancher en connaissance de cause. Aucune garantie de suite."
  ogTitle="Une pause pour vérifier le cap"
  ogDescription="Intervention courte pour mettre sur la table les tensions et trancher en connaissance de cause. Aucune garantie de suite."
  ogType="website"
  ogImage="/og/page-diagnostic.webp"
  ogUrl="https://julien-brionne.fr/diagnostic"
  twitterCard="summary_large_image"
  twitterTitle="Une pause pour vérifier le cap"
  twitterDescription="Intervention courte pour mettre sur la table les tensions et trancher en connaissance de cause. Aucune garantie de suite."
  webPageSchema={webPageSchema}
  breadcrumbSchema={breadcrumbSchema}
>
  <Navbar currentPage="diagnostic" />
  <main>
    <DiagnosticIntro />
    <DiagnosticDefinition />
    <DiagnosticLimits />
    <DiagnosticMethod />
    <DiagnosticResults />
    <Footer />
  </main>
</Layout>
