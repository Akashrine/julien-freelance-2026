---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getBreadcrumbSchema, BreadcrumbItems } from '../../utils/schema';

const LEMON_URL = "https://productcopilot.lemonsqueezy.com/checkout/buy/81d43207-7c71-422f-904c-54daf2cc439b";

const breadcrumbSchema = getBreadcrumbSchema([
  BreadcrumbItems.home,
  BreadcrumbItems.ressources,
  { name: 'Pack Vibe Coding for PMs', url: 'https://www.julien-brionne.fr/ressources/vibe-coding-pm' },
]);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Pack Vibe Coding for PMs",
  description: "12 prompts pour passer de l'idée au produit. PRD, design Stitch, code Claude Code, audit.",
  url: "https://www.julien-brionne.fr/ressources/vibe-coding-pm",
  brand: { "@type": "Brand", name: "Julien Brionne" },
  offers: { "@type": "Offer", price: "29", priceCurrency: "EUR", availability: "https://schema.org/InStock", url: LEMON_URL },
};

const phases = [
  {
    n: "01", label: "CLARIFIER", desc: "Structurer l'idée en brief/PRD",
    prompts: [
      { name: "Le Clarifier", desc: "Mode guidé — idée vague → brief structuré" },
      { name: "Le PRD Builder", desc: "7 inputs → PRD complet en 7 sections" },
      { name: "Le Challenger", desc: "Score /10 avec grille objective + diagnostic par section" },
    ],
  },
  {
    n: "02", label: "DESIGNER", desc: "Créer le design dans Google Stitch",
    prompts: [
      { name: "Le Vibe Designer", desc: "PRD → prompt Google Stitch prêt à coller, inclut états UI" },
      { name: "Le Design-to-Code", desc: "Stitch → prompts Claude Code prêts à copier" },
    ],
  },
  {
    n: "03", label: "CONSTRUIRE", desc: "Coder avec Claude Code, bloc par bloc",
    prompts: [
      { name: "Spec Fondations", desc: "PRD → user stories, schéma données, architecture, events analytics" },
      { name: "Spec Détail", desc: "Fondations → routes, composants, API, plan d'implémentation" },
      { name: "CLAUDE.md Generator", desc: "Spec technique → fichier CLAUDE.md prêt à la racine du projet" },
      { name: "Debug Companion", desc: "Bug → diagnostic → prompt fix, rollback si 2+ indicateurs" },
    ],
  },
  {
    n: "04", label: "VÉRIFIER", desc: "Auditer le résultat, documenter les learnings",
    prompts: [
      { name: "Audit Technique", desc: "6 axes : UX, fonctionnel, SEO, perf, accessibilité, sécurité" },
      { name: "Audit SEO & Growth", desc: "5 dimensions : SEO classique, GEO, AIO, AEO, SXO + scoring /10" },
      { name: "PRD Reviewer", desc: "Review section par section vs résultats réels" },
    ],
  },
];

const faqItems = [
  { q: "Ça marche avec ChatGPT ?", a: "Oui. Optimisé pour Claude mais compatible GPT-4o. Le Prompt 04 (Vibe Designer) utilise Google Stitch." },
  { q: "J'ai besoin de savoir coder ?", a: "Non pour les Phases 1, 2 et 4. La Phase 3 est pour les PMs qui codent. Si tu ne codes pas, les Prompts Spec Fondations/Détail produisent des specs pour ton dev." },
  { q: "C'est quoi un CLAUDE.md ?", a: "Un fichier texte à la racine du projet. Claude Code le lit automatiquement à chaque session. Le CLAUDE.md Generator le crée pour toi à partir de ta spec technique." },
];
---

<Layout
  title="Pack Vibe Coding for PMs — De l'idée au produit qui tourne — Julien Brionne"
  description="12 prompts pour passer de l'idée au produit. PRD, design Stitch, code Claude Code, audit. 29 €, paiement unique."
  breadcrumbSchema={breadcrumbSchema}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Navbar currentPage="ressources" />

  <main>
    <!-- Header -->
    <header class="relative max-w-[1150px] mx-auto px-8 pt-24 pb-20">
      <div class="max-w-3xl reveal">
        <p class="font-mono text-[10px] tracking-[0.3em] text-gray-400 mb-6">[ PACK · 29 € ]</p>
        <div class="w-12 border-b border-gray-200 mb-10"></div>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif text-gray-900 mb-8 leading-tight">
          De l'idée au produit<br />
          <span class="italic text-gray-600">qui tourne.</span>
        </h1>
        <p class="text-lg md:text-xl text-gray-500 font-light leading-relaxed max-w-2xl mb-10">
          12 prompts. 4 phases. Le système complet pour les PMs qui ship.
        </p>
        <div class="flex flex-col sm:flex-row items-start gap-4">
          <a href={LEMON_URL} target="_blank" rel="noopener noreferrer" class="btn-cta font-mono tracking-widest">
            Acheter le pack — 29 €
          </a>
          <p class="text-sm text-gray-400 font-light self-center">Accès immédiat. Fichiers markdown + PDF.</p>
        </div>
      </div>
    </header>

    <!-- Le problème -->
    <section class="max-w-[1150px] mx-auto px-8 py-20 border-t border-gray-100 reveal">
      <div class="max-w-3xl">
        <p class="text-lg md:text-xl text-gray-500 font-light leading-relaxed">
          Tu as une idée. Tu ouvres Claude Code. Tu décris ce que tu veux en 3 phrases.
          3 heures plus tard, tu as un prototype moche qui casse quand tu cliques sur le deuxième bouton.
        </p>
        <p class="text-lg md:text-xl text-gray-900 leading-relaxed mt-4 font-serif italic">
          Le problème n'est pas l'IA. C'est le brief. Et le process.
        </p>
      </div>
    </section>

    <!-- 4 phases -->
    <section class="max-w-[1150px] mx-auto px-8 py-20 border-t border-gray-100 reveal">
      <p class="font-mono text-[10px] tracking-[0.3em] text-gray-400 mb-12">LE SYSTÈME EN 4 PHASES</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {phases.map((phase) => (
          <div class="border border-gray-200 rounded-2xl p-6">
            <p class="font-mono text-[10px] tracking-[0.3em] text-gray-400 mb-2">{phase.n} / {phase.label}</p>
            <p class="text-gray-500 font-light text-sm">{phase.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Ce que tu obtiens -->
    <section class="max-w-[1150px] mx-auto px-8 py-20 border-t border-gray-100 reveal">
      <p class="font-mono text-[10px] tracking-[0.3em] text-gray-400 mb-12">CE QUE TU OBTIENS</p>
      <div class="space-y-12">
        {phases.map((phase) => (
          <div>
            <p class="font-mono text-[10px] tracking-[0.3em] text-gray-400 mb-6">{phase.n} / {phase.label}</p>
            <div class="space-y-3">
              {phase.prompts.map((p) => (
                <div class="flex items-start gap-4 py-3 border-b border-gray-100 last:border-0">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#C5A070] mt-2.5 shrink-0"></span>
                  <div>
                    <span class="text-gray-900 font-medium">{p.name}</span>
                    <span class="text-gray-500 font-light"> — {p.desc}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}

        <!-- Bonus -->
        <div class="border border-gray-200 rounded-2xl p-6 bg-[#F2E9E1]/20">
          <p class="font-mono text-[10px] tracking-[0.3em] text-gray-400 mb-6">INCLUS ÉGALEMENT</p>
          <ul class="space-y-3">
            {[
              "1 workflow complet (mode d'emploi, 3 flows, 7 règles, cas réel)",
              "2 cheatsheets PDF (système + design)",
              "3 templates markdown (CLAUDE.md, Spec de page, Audit technique)",
            ].map((item) => (
              <li class="flex items-start gap-4 text-gray-500 font-light">
                <span class="w-1.5 h-1.5 rounded-full bg-[#C5A070] mt-2 shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Pour qui -->
    <section class="max-w-[1150px] mx-auto px-8 py-20 border-t border-gray-100 reveal">
      <p class="font-mono text-[10px] tracking-[0.3em] text-gray-400 mb-12">POUR QUI</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
        <div>
          <p class="font-mono text-[10px] tracking-[0.2em] text-gray-400 mb-6">CE PACK EST POUR TOI SI</p>
          <ul class="space-y-4 text-gray-500 font-light">
            {[
              "Tu es PM et tu veux coder tes propres outils (landing, prototype, micro-SaaS)",
              "Tu veux écrire des specs que les devs exécutent sans allers-retours",
              "Tu utilises Claude Code, Cursor, ou un outil de coding IA",
              "Tu en as marre de passer plus de temps à debug qu'à construire",
            ].map((item) => (
              <li class="flex items-start gap-4">
                <span class="w-1.5 h-1.5 rounded-full bg-[#C5A070] mt-2 shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-mono text-[10px] tracking-[0.2em] text-gray-400 mb-6">CE PACK N'EST PAS POUR TOI SI</p>
          <ul class="space-y-4 text-gray-400 font-light">
            {[
              "Tu es développeur senior (tu sais déjà écrire des specs techniques)",
              "Tu ne comptes ni coder ni travailler avec des devs",
              "Tu cherches un cours de développement web",
            ].map((item) => (
              <li class="flex items-start gap-4">
                <span class="w-1.5 h-1.5 rounded-full bg-gray-300 mt-2 shrink-0"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Cas réel -->
    <section class="max-w-[1150px] mx-auto px-8 py-20 border-t border-gray-100 reveal">
      <div class="max-w-3xl">
        <p class="font-mono text-[10px] tracking-[0.3em] text-gray-400 mb-8">CAS RÉEL</p>
        <blockquote class="border-l-2 border-[#E5BAAD] pl-8 text-xl md:text-2xl font-serif italic text-gray-600 leading-relaxed" style="border: none; border-left: 2px solid #E5BAAD; padding: 0 0 0 2rem; margin: 0; text-align: left; font-size: inherit;">
          Ce pack est la méthode qu'on a utilisée pour construire productcopilot.fr.
          Du PRD à la prod. Le CLAUDE.md, les specs, l'audit des 16 bugs.
          Tout est documenté dans le workflow.
        </blockquote>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-[1150px] mx-auto px-8 py-20 border-t border-gray-100 reveal">
      <p class="font-mono text-[10px] tracking-[0.3em] text-gray-400 mb-12">QUESTIONS FRÉQUENTES</p>
      <div class="max-w-3xl space-y-0">
        {faqItems.map((item) => (
          <details class="group border-b border-gray-100 py-5">
            <summary class="font-medium text-gray-900 flex items-center justify-between cursor-pointer list-none">
              {item.q}
              <svg viewBox="0 0 16 16" fill="none" class="w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform shrink-0 ml-4" aria-hidden="true">
                <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="mt-3 text-gray-500 font-light leading-relaxed">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA final -->
    <section class="max-w-[1150px] mx-auto px-8 py-20 border-t border-gray-100 reveal">
      <div class="max-w-md">
        <p class="font-mono text-[10px] tracking-[0.3em] text-gray-400 mb-4">PAIEMENT UNIQUE</p>
        <p class="text-6xl font-serif text-gray-900 mb-2">29 €</p>
        <p class="text-gray-400 font-light mb-8">Accès immédiat. Pas d'abonnement.</p>
        <a href={LEMON_URL} target="_blank" rel="noopener noreferrer" class="btn-cta font-mono tracking-widest">
          Acheter le pack
        </a>
        <p class="mt-4 text-xs text-gray-400">Paiement sécurisé via LemonSqueezy.</p>
      </div>
    </section>

    <Footer />
  </main>
</Layout>
