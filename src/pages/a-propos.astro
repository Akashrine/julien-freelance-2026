---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getBreadcrumbSchema, BreadcrumbItems } from '../utils/schema';

// Page d'entité. Elle ne raconte rien de neuf : elle rassemble en un seul
// endroit ce que le site dit déjà de son auteur — le rôle, les terrains, les
// deux faits vérifiables, où il écrit. C'est ce qui permet à un moteur, humain
// ou génératif, de constituer « Julien Brionne » comme une entité unique.
// Aucun fait n'est ajouté qui ne soit déjà publié ailleurs sur le site.

const SITE = 'https://www.julien-brionne.fr';
const LINKEDIN = 'https://www.linkedin.com/in/julienbrionne';
const SUBSTACK = 'https://produitsansfiltre.substack.com';
const MAILTO =
  'mailto:julien.brionne@gmail.com?subject=Un%20sujet%20qui%20n%27avance%20pas';

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${SITE}/a-propos`,
  url: `${SITE}/a-propos`,
  inLanguage: 'fr',
  name: 'À propos — Julien Brionne',
  mainEntity: {
    '@type': 'Person',
    '@id': `${SITE}/#person`,
    name: 'Julien Brionne',
    jobTitle: 'Senior Product Manager freelance',
    url: SITE,
    description:
      "Senior Product Manager freelance. Je reprends les sujets produit qui n'avancent plus et je les mène jusqu'à une mise en production. Quatre scale-ups traversées : Heetch, Back Market, Waalaxy, Wizville.",
    knowsAbout: [
      'organisation produit',
      'ownership produit',
      'structuration d’équipe produit',
      'priorisation et arbitrage produit',
      'alignement Product, Ops et Engineering',
      'outils internes et backoffice',
      'support client comme territoire produit',
      'product management en scale-up',
    ],
    sameAs: [LINKEDIN, SUBSTACK],
  },
};

const breadcrumbSchema = getBreadcrumbSchema([
  BreadcrumbItems.home,
  { name: 'À propos', url: `${SITE}/a-propos` },
]);
---

<Layout
  title="À propos — Julien Brionne, Senior Product Manager freelance"
  description="Senior Product Manager freelance. Quatre scale-ups traversées : Heetch, Back Market, Waalaxy, Wizville. Je reprends les sujets produit qui n'avancent plus et je les mène jusqu'en production."
  ogTitle="À propos — Julien Brionne"
  ogDescription="Senior Product Manager freelance. Quatre scale-ups traversées : Heetch, Back Market, Waalaxy, Wizville."
  ogType="profile"
  ogUrl={`${SITE}/a-propos`}
  twitterCard="summary_large_image"
  twitterTitle="À propos — Julien Brionne"
  twitterDescription="Senior Product Manager freelance. Quatre scale-ups traversées : Heetch, Back Market, Waalaxy, Wizville."
  webPageSchema={profileSchema}
  breadcrumbSchema={breadcrumbSchema}
>
  <Navbar />
  <main id="contenu" tabindex="-1">
    <!-- L'identité, en une phrase -->
    <section class="px-6 pt-24 pb-20 sm:px-10 sm:pt-36 sm:pb-28">
      <div class="shell space-y-12 sm:space-y-16">
        <div class="space-y-6">
          <p class="eyebrow reveal">À propos</p>
          <h1 class="t-display max-w-[20ch] text-ink reveal">
            Julien Brionne, <span class="text-dim italic">Senior Product Manager freelance.</span>
          </h1>
        </div>
        <div class="measure-wide space-y-5 text-lg leading-relaxed sm:text-xl reveal">
          <p class="text-ink">
            Je reprends les sujets produit qui n’avancent plus et je les mène jusqu’à une
            mise en production.
          </p>
          <p class="text-dim">
            J’interviens quand il faut enfin décider quoi construire, ou quand un sujet
            important n’arrive pas jusqu’en production.
          </p>
        </div>
      </div>
    </section>

    <!-- Les terrains -->
    <section class="border-t border-line px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell">
        <div class="split reveal">
          <p class="split-aside eyebrow">Terrains</p>
          <div class="space-y-7">
            <h2 class="t-title text-ink">Quatre scale-ups.</h2>
            <div class="max-w-[38rem] space-y-5 text-lg leading-relaxed text-dim">
              <p>
                J’ai traversé quatre scale-ups : <strong class="font-semibold text-ink">Heetch</strong>,
                où j’ai passé quatre ans et structuré l’équipe produit care depuis zéro,
                <strong class="font-semibold text-ink">Back Market</strong>,
                <strong class="font-semibold text-ink">Waalaxy</strong> et
                <strong class="font-semibold text-ink">Wizville</strong>.
              </p>
              <p>
                Dans chacune, le même schéma : les outils internes et le care sont les
                derniers sujets à recevoir un owner produit dédié.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Deux faits vérifiables -->
    <section class="border-t border-line px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell">
        <div class="split reveal">
          <p class="split-aside eyebrow">Preuves</p>
          <div class="space-y-8">
            <h2 class="t-title text-ink">Deux fois où ça a marché<span class="stop">.</span></h2>
            <div class="max-w-[38rem] space-y-8 text-lg leading-relaxed text-dim">
              <p>
                <strong class="font-semibold text-ink">Back Market.</strong>
                Un chantier téléphone ouvert depuis plus d’un an, en double run entre deux
                outils. Quatre mois après mon arrivée, les appels entrants passent en
                production sur quatre marchés en trois semaines. Première semaine en
                Allemagne : <span class="text-ink">100 % des appels décrochés.</span>
              </p>
              <p>
                <strong class="font-semibold text-ink">Heetch.</strong>
                Je fais supprimer la notation des chauffeurs à cinq étoiles, le standard du
                secteur, parce qu’elle mesurait autre chose que ce qu’elle annonçait. Cinq
                ans plus tard, elle est toujours absente de l’application.
                <span class="text-ink">Vous pouvez l’ouvrir et vérifier.</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Ce que j'écris -->
    <section class="border-t border-line px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell">
        <div class="split reveal">
          <p class="split-aside eyebrow">Écrits</p>
          <div class="space-y-7">
            <h2 class="t-title text-ink">Ce que j’écris, c’est comment je travaille.</h2>
            <div class="max-w-[38rem] space-y-5 text-lg leading-relaxed text-dim">
              <p>
                J’écris <a href={SUBSTACK} class="link-inline" rel="noopener">Produit Sans Filtre</a>,
                une newsletter sur les décisions produit, et je publie des textes de fond sur
                l’organisation produit en scale-up.
              </p>
              <p>
                <a href="/articles" class="link-inline">Douze textes</a> sont en accès libre :
                ownership, structuration d’équipe, backoffice legacy, care, alignement entre
                Product, Ops et Engineering.
              </p>
            </div>
            <p>
              <a href="/ecrits" class="door text-base">
                <span>Où je publie</span>
                <span class="door-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Où me trouver -->
    <section class="border-t border-line px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell">
        <div class="split reveal">
          <p class="split-aside eyebrow">Me joindre</p>
          <div class="space-y-7">
            <h2 class="t-title text-ink">Comment ça commence<span class="stop">.</span></h2>
            <div class="max-w-[38rem] space-y-5 text-lg leading-relaxed text-dim">
              <p>
                Écrivez-moi. Trois choses suffisent : ce qui n’avance pas, depuis combien de
                temps, et qui peut trancher chez vous.
              </p>
              <p>
                Je suis aussi sur <a href={LINKEDIN} class="link-inline" rel="noopener">LinkedIn</a>.
              </p>
            </div>
            <p class="flex flex-wrap gap-x-10 gap-y-4">
              <a href={MAILTO} class="door text-base">
                <span>M’écrire</span>
                <span class="door-arrow" aria-hidden="true">&rarr;</span>
              </a>
              <a href="/ce-que-je-fais" class="door text-base">
                <span>Ce que je fais</span>
                <span class="door-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>

    <Footer links={[
      { href: '/ecrits', label: 'Écrits' },
      { href: '/mentions-legales', label: 'Mentions légales' },
    ]} />
  </main>
</Layout>
