---
// Écrits. Copy validée le 11/10/2026 (refonte Product Lead freelance).
// Ne pas reformuler : toute modification de texte passe par Julien.
//
// Page éditoriale, pas commerciale. Elle absorbe l'ancien index /articles
// (redirigé ici) ; les URLs /articles/[slug] restent en ligne, reliées entre
// elles par les liens des articles et la navigation précédent / suivant.
//
// Trois entrées seulement, toutes publiées, alignées avec le territoire et
// compatibles avec 04_CASES.md (site-architecture.md, Écrits mis en avant).
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getWebPageSchema, getBreadcrumbSchema, BreadcrumbItems } from '../utils/schema';
import { mailto } from '../utils/mail';

const SUBSTACK = 'https://produitsansfiltre.substack.com';
const LINKEDIN = 'https://www.linkedin.com/in/julienbrionne';
const TITLE = 'Écrits · Julien Brionne';
const DESCRIPTION =
  'Produit Sans Filtre et des textes sur les organisations produit : les explications qui arrivent avant le problème, les décisions qui ne tiennent pas.';

const entrees = [
  {
    titre: '« On itérera ».',
    resume: 'L’itération est parfois une façon de ne pas décider.',
    href: 'https://produitsansfiltre.substack.com/p/on-iterera',
  },
  {
    titre: 'Le churn ne ment pas.',
    resume:
      'Quand le churn monte, chacun arrive avec une explication cohérente. On regarde rarement les décisions qui l’ont précédé.',
    href: 'https://produitsansfiltre.substack.com/p/le-churn-ne-ment-pas',
  },
  {
    titre: 'Les produits invisibles.',
    resume:
      'Back-office, règles, permissions, notifications. Les produits que personne ne montre en démo, et qui racontent souvent plus de choses sur une boîte que son produit public.',
    href: 'https://produitsansfiltre.substack.com/p/les-produits-invisibles',
  },
];

const breadcrumbSchema = getBreadcrumbSchema([BreadcrumbItems.home, BreadcrumbItems.ecrits]);
---

<Layout
  preloadSerifItalic={false}
  title={TITLE}
  description={DESCRIPTION}
  ogTitle="Ce que j’écris, c’est comment je travaille."
  webPageSchema={getWebPageSchema('https://www.julien-brionne.fr/ecrits', 'Écrits', DESCRIPTION)}
  breadcrumbSchema={breadcrumbSchema}
  ogImage="/og/page-ecrits.webp"
  twitterCard="summary_large_image"
>
  <Navbar current="ecrits" />

  <main id="contenu" tabindex="-1">
    {/* 1. Ouverture */}
    <section class="px-6 pt-24 pb-20 sm:px-10 sm:pt-36 sm:pb-28">
      <div class="shell space-y-12">
        <h1 class="reveal-load t-display max-w-[18ch] text-ink">
          Ce que j’écris, c’est comment je travaille<span class="stop">.</span>
        </h1>
        <div class="reveal-load measure-wide space-y-5 text-lg leading-relaxed text-dim sm:text-xl" style="--index:1">
          <p>
            J’écris sur ce que je vois dans les organisations produit. Les explications qui
            arrivent avant le problème. Les décisions qui se rejouent. Les features livrées que
            personne n’utilise.
          </p>
          <p>Si vous vous y reconnaissez, on finira par se parler. Sinon, vous m’aurez lu gratuitement.</p>
        </div>
      </div>
    </section>

    {/* 2. Produit Sans Filtre. Action principale de la page. */}
    <section class="px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell space-y-8">
        <h2 class="t-title text-ink">Produit Sans Filtre</h2>
        <p class="measure-wide text-lg leading-relaxed text-dim">
          Toutes les deux semaines. C’est là que je prends le temps : plus long qu’un post, plus de
          place pour la nuance, et pour le doute quand je n’ai pas la réponse.
        </p>
        <div class="space-y-3 pt-2">
          <p>
            <a href={SUBSTACK} rel="noopener" class="door font-serif text-xl sm:text-2xl">
              <span>S’inscrire</span>
              <span class="door-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </p>
          <p class="text-sm text-dim">Gratuit.</p>
        </div>
      </div>
    </section>

    {/* 3. Par où commencer */}
    <section class="px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell space-y-10 sm:space-y-12">
        <h2 class="t-sub text-ink">Par où commencer</h2>
        <ul class="measure-wide space-y-8">
          {entrees.map((e) => (
            <li class="space-y-1.5">
              <a href={e.href} rel="noopener" class="link-inline block font-serif text-xl leading-snug sm:text-2xl">
                {e.titre}
              </a>
              <p class="leading-relaxed text-dim">{e.resume}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* 4. LinkedIn */}
    <section class="px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell space-y-6">
        <h2 class="t-sub text-ink">Sur LinkedIn</h2>
        <p class="measure-wide text-lg leading-relaxed text-dim">
          Des textes plus courts, pris dans la semaine. Une phrase entendue en réunion, une décision
          qu’on rejoue pour la troisième fois, un tableau de bord que personne ne regarde.
        </p>
        <p>
          <a href={LINKEDIN} rel="noopener" class="door text-base">
            <span>Suivre sur LinkedIn</span>
            <span class="door-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </p>
      </div>
    </section>

    {/* 5. Ligne de fin. En texte, jamais en bouton, pas de lien vers les offres. */}
    <section class="px-6 py-12 sm:px-10 sm:py-14">
      <div class="shell">
        <p class="measure-wide text-sm leading-relaxed text-dim sm:text-base">
          Si un de ces textes décrit ce qui se passe chez vous, <a href={mailto()} class="link-inline">écrivez-moi</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
