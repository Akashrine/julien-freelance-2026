---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ApproachIntro from '../components/ApproachIntro.astro';
import ApproachTriggers from '../components/ApproachTriggers.astro';
import ApproachActions from '../components/ApproachActions.astro';
import ApproachLimits from '../components/ApproachLimits.astro';
import ReferencesFooter from '../components/ReferencesFooter.astro';
import Footer from '../components/Footer.astro';
import { getWebPageSchema, getBreadcrumbSchema, BreadcrumbItems, getFAQSchema } from '../utils/schema';

const siteUrl = 'https://julien-brionne.fr';
const webPageSchema = getWebPageSchema(
  `${siteUrl}/approche`,
  'Ce que je fais — Julien Brionne',
  'Je m\'immerge dans l\'équipe pour remettre de l\'ordre. Ownership, outils internes, coordination, process. Senior PM, 10+ ans, 4 scale-ups structurées.',
  ['intervention produit', 'organisation scale-up', 'ownership produit', 'PM freelance']
);
const breadcrumbSchema = getBreadcrumbSchema([
  BreadcrumbItems.home,
  BreadcrumbItems.approche,
]);
const faqSchema = getFAQSchema([
  {
    question: "Julien Brionne utilise-t-il une méthode clés en main ?",
    answer: "Non. Chaque organisation est un système vivant. Je tranche en fonction du terrain, pas d'un playbook."
  },
  {
    question: "Est-ce du coaching théorique ?",
    answer: "Non. Je m'implique dans les arbitrages et je partage la responsabilité des résultats avec l'équipe."
  },
  {
    question: "Quand intervient Julien Brionne ?",
    answer: "Quand la croissance a dépassé la structure : ownership flou, outils internes bricolés, coordination qui bouffe l'exécution."
  },
]);
---

<Layout
  title="Ce que je fais — Julien Brionne, Senior PM Freelance"
  description="Je m'immerge dans l'équipe pour remettre de l'ordre. Ownership, outils internes, coordination, process. Senior PM, 10+ ans, 4 scale-ups structurées."
  ogTitle="Ce que je fais — Julien Brionne"
  ogDescription="Je m'immerge dans l'équipe pour remettre de l'ordre. Ownership, outils internes, coordination, process."
  ogType="website"
  ogImage="/og/page-approche.webp"
  ogUrl="https://julien-brionne.fr/approche"
  twitterCard="summary_large_image"
  twitterTitle="Ce que je fais — Julien Brionne"
  twitterDescription="Je m'immerge dans l'équipe pour remettre de l'ordre. Ownership, outils internes, coordination, process."
  webPageSchema={webPageSchema}
  breadcrumbSchema={breadcrumbSchema}
  faqSchema={faqSchema}
>
  <Navbar currentPage="approche" />
  <main>
    <ApproachIntro />
    <ApproachTriggers />
    <ApproachActions />
    <ApproachLimits />
    <ReferencesFooter />
    <Footer />
  </main>
</Layout>
