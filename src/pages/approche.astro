---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ApproachIntro from '../components/ApproachIntro.astro';
import ApproachTriggers from '../components/ApproachTriggers.astro';
import ApproachActions from '../components/ApproachActions.astro';
import ApproachLimits from '../components/ApproachLimits.astro';
import ApproachPrisms from '../components/ApproachPrisms.astro';
import Footer from '../components/Footer.astro';
import { getWebPageSchema, getBreadcrumbSchema, BreadcrumbItems } from '../utils/schema';

const siteUrl = 'https://julien-brionne.fr';
const pageUrl = `${siteUrl}/approche`;
const webPageSchema = getWebPageSchema(
  pageUrl,
  'Mon approche',
  'Leadership opérationnel. Une approche d\'intervention, pas une méthode. Fermer ce qui devrait l\'être, participer aux arbitrages, assumer les décisions impopulaires : déprioriser des clients, supprimer des features, dire non à Sales.',
  ['leadership opérationnel', 'arbitrage produit', 'décisions impopulaires', 'trancher']
);
const breadcrumbSchema = getBreadcrumbSchema([
  BreadcrumbItems.home,
  BreadcrumbItems.approche,
]);
---

<Layout
  title="Approche — Julien Brionne"
  description="Leadership opérationnel. Une approche d'intervention, pas une méthode. Fermer ce qui devrait l'être, participer aux arbitrages, assumer les décisions impopulaires : déprioriser des clients, supprimer des features, dire non à Sales."
  ogTitle="Leadership opérationnel"
  ogDescription="Une approche d'intervention, pas une méthode. Fermer ce qui devrait l'être. Participer aux arbitrages, assumer les décisions impopulaires."
  ogType="website"
  ogImage="/og/page-approche.webp"
  ogUrl="https://julien-brionne.fr/approche"
  twitterCard="summary_large_image"
  twitterTitle="Leadership opérationnel"
  twitterDescription="Une approche d'intervention, pas une méthode. Fermer ce qui devrait l'être. Participer aux arbitrages, assumer les décisions impopulaires."
  webPageSchema={webPageSchema}
  breadcrumbSchema={breadcrumbSchema}
>
  <Navbar currentPage="approche" />
  <main>
    <ApproachIntro />
    <ApproachTriggers />
    <ApproachActions />
    <ApproachLimits />
    <ApproachPrisms />
    <Footer />
  </main>
</Layout>
