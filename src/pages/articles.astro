---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ArticlesHeader from '../components/ArticlesHeader.astro';
import ArticlesList from '../components/ArticlesList.astro';
import Footer from '../components/Footer.astro';
import { getWebPageSchema, getBreadcrumbSchema, BreadcrumbItems } from '../utils/schema';

const siteUrl = 'https://www.julien-brionne.fr';
const pageUrl = `${siteUrl}/articles`;
const webPageSchema = getWebPageSchema(
  pageUrl,
  'Articles',
  'Réflexions et analyses de cas. Des textes pour trancher le raisonnement avant d\'agir, pas des guides méthodologiques.',
  ['réflexions produit', 'analyses de cas', 'décision produit', 'trancher']
);
const breadcrumbSchema = getBreadcrumbSchema([
  BreadcrumbItems.home,
  BreadcrumbItems.articles,
]);
---

<Layout
  title="Articles — Réflexions produit | Julien Brionne"
  description="Réflexions et analyses de cas produit. Trancher le raisonnement avant d'agir. Pas des guides méthodologiques."
  ogTitle="Articles — Réflexions produit"
  ogDescription="Réflexions et analyses de cas produit. Trancher le raisonnement avant d'agir. Pas des guides méthodologiques."
  ogType="website"
  ogImage="/og/page-articles.webp"
  ogUrl="https://www.julien-brionne.fr/articles"
  twitterCard="summary_large_image"
  twitterTitle="Articles — Réflexions produit"
  twitterDescription="Réflexions et analyses de cas produit. Trancher le raisonnement avant d'agir. Pas des guides méthodologiques."
  webPageSchema={webPageSchema}
  breadcrumbSchema={breadcrumbSchema}
>
  <Navbar currentPage="articles" />
  <Breadcrumb items={[{ name: 'Accueil', url: '/' }, { name: 'Articles' }]} />
  <main>
    <ArticlesHeader />
    <ArticlesList />
    <Footer />
  </main>
</Layout>
