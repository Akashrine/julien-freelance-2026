---
// Ce que je fais. Copy validée le 11/10/2026 (refonte Product Lead freelance),
// reprise le 12/10/2026 sur la voix du « Infos » LinkedIn : copy de référence
// dans 02_CONTENT/SORTIES/2026-10-12_Site-copy-voix-About.md.
// Ne pas reformuler : toute modification de texte passe par Julien.
//
// La page répond à : « Dans ma situation, Julien doit-il porter le sujet avec
// nous, ou a-t-on d'abord besoin de trancher ? »
//
// Ancres. #porter et #la-mise-au-clair sont les deux sections.
// #le-copilote (ancienne offre) est posé sur Porter, #le-rendez-vous-produit
// (ancienne offre) sur le bloc « lequel des deux » : des liens partent dessus
// depuis LinkedIn et des DM. Aucune ancienne offre n'est affichée.
//
// Preuve côté Porter : Heetch, équipe Care et admin (04_CASES.md, publiable
// sans chiffre). Jaume Avila Estivill cité sans entreprise (CASES).
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getWebPageSchema, getServiceSchemas, getBreadcrumbSchema, BreadcrumbItems } from '../utils/schema';
import { EMAIL, mailto } from '../utils/mail';
import { PORTER, MISE_AU_CLAIR } from '../utils/offres';

const TITLE = 'Product Lead freelance : mission longue ou décision produit · Julien Brionne';
const DESCRIPTION =
  'Besoin de quelqu’un pour porter un sujet produit pendant plusieurs mois, ou d’abord de trancher une question ? Voici comment je travaille.';

const porterSi = [
  'Vous savez où aller. Il manque quelqu’un pour tenir le sujet jusqu’au bout.',
  'Le sujet traverse plusieurs équipes, et chacune n’en voit qu’une partie.',
  'Il faudra faire des choix chaque semaine, pas une seule fois.',
  'Vous voulez savoir si ça a marché, pas seulement que c’est sorti.',
];

const trancherSi = [
  'Plusieurs explications circulent pour le même problème.',
  'Une feature importante est livrée et peu utilisée, et personne ne sait dire pourquoi.',
  'La roadmap se remplit de demandes, et rien ne dit lesquelles comptent.',
  'L’équipe livre, mais ne sait plus ce que ça change.',
];

const dedans = [
  {
    titre: 'Je commence par creuser.',
    texte:
      'Même en mission longue, le sujet arrive avec son explication déjà prête. Je regarde l’usage, la data, et je parle à ceux qui vivent le problème. Souvent, le vrai problème est hors de l’écran.',
  },
  {
    titre: 'Je fais les choix avec vous.',
    texte:
      'Ce qui entre, ce qui attend, ce qu’on arrête. Avec ceux qui ont le droit de décider, pour que la décision ne se rejoue pas à chaque réunion.',
  },
  {
    titre: 'Je construis avec l’équipe.',
    texte:
      'Avec le design, la tech et la data. J’ai été développeur : quand il faut, je descends dans le modèle de données ou l’architecture.',
  },
  {
    titre: 'Je reviens voir si ça a marché.',
    texte:
      'Je ne quitte pas le sujet quand il sort. On regarde si l’usage a changé comme prévu, et on décide de la suite à partir de ça.',
  },
];

const terrains = [
  'Le Customer Care et le support.',
  'Les plateformes et les outils internes que tout le monde utilise et que personne ne possède.',
  'L’e-commerce et le checkout.',
  'La mesure et la data : vérifier qu’un indicateur mesure ce qu’il prétend, jusque dans le modèle de données.',
];

const pendantLeMois = [
  {
    titre: 'On part d’une question.',
    texte:
      'Assez précise pour être tranchée. « Pourquoi on n’avance pas ? » ne se tranche pas. « Faut-il refaire l’onboarding, et pour qui ? » se tranche.',
  },
  {
    titre: 'Je regarde ce qui se passe vraiment.',
    texte:
      'L’usage, les données, les tickets, les décisions déjà prises. Et les personnes qui vivent le sujet, pas seulement celles qui le pilotent.',
  },
  {
    titre: 'On décide ensemble.',
    texte:
      'Je mets sur la table ce que les faits montrent. La décision se prend avec vous, pendant le mois, pas dans un rapport après.',
  },
  {
    titre: 'On prépare la suite.',
    texte:
      'On écrit ce qu’on vise, comment on saura si ça marche, et par quoi l’équipe commence sans moi.',
  },
];

const aLaFin = [
  'Une décision explicite sur ce qu’on construit. Parfois sur ce qu’on arrête.',
  'Les personnes pour qui on le construit.',
  'La manière de savoir si ça marche.',
  'Par quoi l’équipe commence sans moi.',
];

const pasCeci = [
  'Une roadmap déroulée à votre place.',
  'Du coaching pour votre équipe produit.',
  'Un mois de PM en renfort. Si le sujet a besoin de quelqu’un pour le porter, c’est l’autre format.',
];

const breadcrumbSchema = getBreadcrumbSchema([BreadcrumbItems.home, BreadcrumbItems.ceQueJeFais]);
---

<Layout
  title={TITLE}
  description={DESCRIPTION}
  ogTitle="Product Lead freelance : mission longue ou décision produit"
  webPageSchema={getWebPageSchema('https://www.julien-brionne.fr/ce-que-je-fais', 'Ce que je fais', DESCRIPTION)}
  serviceSchemas={getServiceSchemas()}
  breadcrumbSchema={breadcrumbSchema}
  ogImage="/og/page-ce-que-je-fais.webp"
  twitterCard="summary_large_image"
>
  <Navbar current="ce-que-je-fais" />

  <main id="contenu" tabindex="-1">
    {/* 1. Ouverture. */}
    <section class="px-6 pt-24 pb-20 sm:px-10 sm:pt-36 sm:pb-28">
      <div class="shell space-y-12 sm:space-y-16">
        <h1 class="reveal-load t-display max-w-[20ch] text-ink" style="--index:0">
          Quelqu’un pour plusieurs mois, ou d’abord une décision&nbsp;?
        </h1>
        <div class="reveal-load measure-wide space-y-5 text-lg leading-relaxed sm:text-xl" style="--index:1">
          <p class="text-ink">
            Dans les deux cas, le début est le même : comprendre ce qui se passe vraiment, parler aux utilisateurs et aux équipes qui vivent le problème, regarder l’usage et la data, puis choisir une direction.
          </p>
          <p class="text-dim">
            La différence, c’est la suite. Soit je reste plusieurs mois, jusqu’à savoir si ça a marché. Soit vous avez d’abord besoin de savoir quoi faire, et je m’arrête là.
          </p>
        </div>
      </div>
    </section>

    {/* 2. Lequel des deux. L'arbre ne se dessine qu'à partir de lg ; en
         dessous, les deux branches s'empilent. */}
    <section id="le-rendez-vous-produit" class="reveal px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell space-y-12 sm:space-y-14">
        <div class="schema">
          <span class="schema-root" aria-hidden="true">.</span>
          <span class="schema-drop" aria-hidden="true"></span>
          <span class="schema-bar" aria-hidden="true"></span>
          <span class="schema-leg schema-leg-l" aria-hidden="true"></span>
          <span class="schema-leg schema-leg-r" aria-hidden="true"></span>

          <div class="schema-branch">
            <div class="schema-branch-inner space-y-5">
              <h2 class="t-sub text-ink">Il vous faut quelqu’un pour plusieurs mois si&nbsp;:</h2>
              <ul class="space-y-3 text-lg leading-relaxed text-dim">
                {porterSi.map((ligne) => (
                  <li class="grid grid-cols-[1rem_minmax(0,1fr)] gap-2">
                    <span class="text-dim" aria-hidden="true">·</span>
                    <span>{ligne}</span>
                  </li>
                ))}
              </ul>
              <p class="pt-1">
                <a href={PORTER.ancre} class="door text-base">
                  <span>Porter un sujet</span>
                  <span class="door-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </p>
            </div>
          </div>

          <div class="schema-branch mt-12 lg:mt-0">
            <div class="schema-branch-inner space-y-5">
              <h2 class="t-sub text-ink">Il vous faut d’abord une décision si&nbsp;:</h2>
              <ul class="space-y-3 text-lg leading-relaxed text-dim">
                {trancherSi.map((ligne) => (
                  <li class="grid grid-cols-[1rem_minmax(0,1fr)] gap-2">
                    <span class="text-dim" aria-hidden="true">·</span>
                    <span>{ligne}</span>
                  </li>
                ))}
              </ul>
              <p class="pt-1">
                <a href={MISE_AU_CLAIR.ancre} class="door text-base">
                  <span>La Mise au clair</span>
                  <span class="door-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </p>
            </div>
          </div>
        </div>

        <p class="measure-wide text-lg leading-relaxed text-dim lg:mx-auto lg:text-center">
          Ce ne sont pas des cases à cocher. Si vous vous reconnaissez des deux côtés, on commence
          par en parler.
        </p>
      </div>
    </section>

    {/* 3. Porter. L'ancienne ancre #le-copilote pointe ici. */}
    <section id="porter" class="px-6 py-16 sm:px-10 sm:py-24">
      <span id="le-copilote" aria-hidden="true"></span>
      <div class="shell space-y-10 sm:space-y-12">
        <header class="border-b border-line pb-6">
          <h2 class="t-title text-ink">Porter un sujet</h2>
        </header>

        <div class="split">
          <div class="split-aside" aria-hidden="true"></div>
          <p class="text-lg leading-relaxed text-ink sm:text-xl">
            C’est l’essentiel de mon travail. Aujourd’hui chez Back Market, je porte le Sales Customer Care, après plusieurs mois sur la Care Platform.
          </p>
        </div>

        <div class="split">
          <h3 class="split-aside font-semibold text-ink">Ce que je fais une fois dedans</h3>
          <div class="space-y-7">
            {dedans.map((d) => (
              <div class="space-y-1.5">
                <p class="font-semibold text-ink">{d.titre}</p>
                <p class="text-lg leading-relaxed text-dim">{d.texte}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="split">
          <h3 class="split-aside font-semibold text-ink">Mes terrains</h3>
          <ul class="space-y-3 text-lg leading-relaxed text-dim">
            {terrains.map((t) => (
              <li class="grid grid-cols-[1rem_minmax(0,1fr)] gap-2">
                <span class="text-dim" aria-hidden="true">·</span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="split">
          <h3 class="split-aside font-semibold text-ink">Un exemple</h3>
          <p class="text-lg leading-relaxed text-dim">
            Chez Heetch, le Care n’avait pas d’équipe produit. Deux personnes, des outils éparpillés
            côté Ops. L’admin interne servait chaque jour au Produit, aux Ops et au Support, et
            n’appartenait à personne. J’ai créé l’équipe produit Care, puis on a refait l’admin pour en faire un outil commun, alimenté par les différentes équipes.
          </p>
        </div>

        <figure class="split">
          <div class="split-aside" aria-hidden="true"></div>
          <div class="space-y-3">
            <blockquote lang="en" class="font-serif text-lg italic leading-relaxed text-ink sm:text-xl">
              “He did an outstanding job taking charge of major initiatives, defining clear project
              needs, and managing stakeholder expectations with ease. Julien communicates
              brilliantly with engineers.”
            </blockquote>
            <figcaption class="text-sm text-dim">Jaume Avila Estivill, Engineering Leader</figcaption>
          </div>
        </figure>

        <div class="split">
          <div class="split-aside" aria-hidden="true"></div>
          <p>
            <a href={mailto('mission')} class="door text-base sm:text-lg">
              <span>Proposer une mission</span>
              <span class="door-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </div>
      </div>
    </section>

    {/* 4. La Mise au clair. */}
    <section id="la-mise-au-clair" class="px-6 py-16 sm:px-10 sm:py-24">
      <div class="shell space-y-10 sm:space-y-12">
        <header class="border-b border-line pb-6">
          <h2 class="t-title text-ink">La Mise au clair</h2>
        </header>

        <div class="split">
          <div class="split-aside" aria-hidden="true"></div>
          <p class="text-lg leading-relaxed text-ink sm:text-xl">
            Parfois, une équipe livre mais ne sait plus ce que ça change. Elle n’a pas besoin d’un Product Lead pendant six mois, elle a besoin de savoir quoi faire ensuite. Pour ça, je propose La Mise au clair : un mois avec vous et les personnes Produit, Tech ou Data utiles.
          </p>
        </div>

        <div class="split">
          <h3 class="split-aside font-semibold text-ink">Quand elle sert</h3>
          <div class="space-y-5 text-lg leading-relaxed text-dim">
            <p>
              Votre équipe livre, mais plus personne ne sait dire ce qui marche, ce qu’il faut arrêter, ni ce qu’on construit ensuite.
            </p>
            <p>
              Elle est surtout utile quand une équipe Produit et Tech existe déjà. Sans équipe en
              place, le besoin est souvent ailleurs. On en parle, et je vous dis si c’est le bon
              format.
            </p>
          </div>
        </div>

        <div class="split">
          <h3 class="split-aside font-semibold text-ink">Pendant le mois</h3>
          <div class="space-y-7">
            {pendantLeMois.map((m) => (
              <div class="space-y-1.5">
                <p class="font-semibold text-ink">{m.titre}</p>
                <p class="text-lg leading-relaxed text-dim">{m.texte}</p>
              </div>
            ))}
            <p class="text-lg leading-relaxed text-dim">
              Le temps que je passe dans le mois dépend de la question. On le fixe ensemble avant de
              commencer.
            </p>
          </div>
        </div>

        <div class="split">
          <h3 class="split-aside font-semibold text-ink">Ce que vous avez à la fin</h3>
          <ul class="space-y-3 text-lg leading-relaxed text-dim">
            {aLaFin.map((l) => (
              <li class="grid grid-cols-[1rem_minmax(0,1fr)] gap-2">
                <span class="text-dim" aria-hidden="true">·</span>
                <span>{l}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="split">
          <h3 class="split-aside font-semibold text-ink">Ce qui fait tenir une décision</h3>
          <p class="text-lg leading-relaxed text-dim">
            Pendant le mois, on se demande aussi qui défendra la décision quand un client demandera l’inverse, ce qui pourrait
            légitimement la rouvrir, et quels signes montreraient qu’elle se défait.
          </p>
        </div>

        <div class="split">
          <h3 class="split-aside font-semibold text-ink">Ce que ce n’est pas</h3>
          <ul class="space-y-3 text-lg leading-relaxed text-dim">
            {pasCeci.map((l) => (
              <li class="grid grid-cols-[1rem_minmax(0,1fr)] gap-2">
                <span class="text-dim" aria-hidden="true">·</span>
                <span>{l}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="split">
          <div class="split-aside" aria-hidden="true"></div>
          <p>
            <a href={mailto('miseAuClair')} class="door text-base sm:text-lg">
              <span>Parler de La Mise au clair</span>
              <span class="door-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </p>
        </div>
      </div>
    </section>

    {/* 5. Fermeture. */}
    <section class="px-6 py-20 sm:px-10 sm:py-28">
      <div class="shell split">
        <div class="split-aside" aria-hidden="true"></div>
        <div class="space-y-8">
          <h2 class="t-title text-ink">Vous hésitez entre les deux&nbsp;?</h2>
          <p class="text-lg leading-relaxed text-dim">
            Écrivez-moi quand même : le sujet, l’explication qu’on en donne chez vous, et qui tranche. On verra ensemble ce qu’il lui faut.
          </p>
          <div class="space-y-3 pt-2">
            <p>
              <a href={mailto()} class="door font-serif text-xl sm:text-2xl">
                <span>M’écrire</span>
                <span class="door-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </p>
            <p class="text-sm text-dim">{EMAIL}</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
