<section id="cta-home" class="relative py-32 overflow-hidden section-fade">
  <!-- Halo lumineux central -->
  <div class="absolute top-[30%] left-1/2 -translate-x-1/2 w-[600px] h-[400px] halo-sand -z-10 pointer-events-none opacity-50"></div>

  <div class="max-w-[1150px] mx-auto px-8 text-center relative z-10">
    <div class="reveal">
      <p class="text-base md:text-lg text-gray-500 font-light mb-12 tracking-wide">
        30 minutes pour comprendre ton contexte et voir si mon approche est utile.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/contact"
          class="btn-cta font-mono tracking-widest text-[10px]"
        >
          Discuter de ta situation
        </a>
        <a
          href="/articles"
          class="font-mono text-[10px] tracking-widest text-gray-600 border border-gray-300 px-8 py-4 hover:border-gray-600 hover:text-gray-900 transition-colors duration-200"
        >
          Lire les articles
        </a>
      </div>
    </div>
  </div>
</section>
