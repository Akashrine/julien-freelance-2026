---
// Pied de page. La ligne mission longue n'apparaît que sur / et /ce-que-je-fais,
// en texte, sans prix et sans lien. site-architecture.md, section Navigation.
interface Props {
  missionLongue?: boolean;
  links?: { href: string; label: string }[];
}
const {
  missionLongue = false,
  links = [
    { href: '/a-propos', label: 'À propos' },
    { href: '/ecrits', label: 'Écrits' },
    { href: '/mentions-legales', label: 'Mentions légales' },
  ],
  // Trois pages d'entrée, atteintes par recherche. Elles étaient dans le
  // sitemap et dans aucun lien du site : indexables, mais sans aucune
  // importance aux yeux d'un moteur, et introuvables pour un humain qui
  // arrive par l'accueil. Elles restent au pied de page, en retrait —
  // ce sont des entrées, pas des destinations.
  entrees = [
    { href: '/situations', label: 'Reconnaître la situation' },
    { href: '/diagnostic', label: 'Diagnostic produit' },
    { href: '/product-manager-freelance-pme', label: 'PM freelance en PME' },
  ],
} = Astro.props;
---

<footer class="mt-32 border-t border-line px-6 py-14 sm:mt-44 sm:px-10">
  <div class="shell flex flex-col gap-8 sm:flex-row sm:items-baseline sm:justify-between">
    <div class="space-y-3">
      <p class="wordmark text-base sm:text-lg">
        <span class="wordmark-given">Julien</span> <span class="wordmark-family">Brionne</span><span class="wordmark-dot">.</span>
      </p>
      {missionLongue && (
        <p class="max-w-sm text-sm leading-relaxed text-dim">
          Je suis aussi disponible en mission longue comme Senior Product Manager embarqué.
        </p>
      )}
    </div>

    <nav aria-label="Navigation de pied de page" class="space-y-5">
      <ul class="flex flex-col gap-3 text-sm sm:flex-row sm:gap-8">
        {links.map((link) => (
          <li><a href={link.href} class="link-nav">{link.label}</a></li>
        ))}
      </ul>
      <ul class="flex flex-col gap-3 text-sm sm:flex-row sm:gap-8">
        {entrees.map((link) => (
          <li><a href={link.href} class="link-nav">{link.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
