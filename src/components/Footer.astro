---
// Pied de page minimal, identique partout : email, LinkedIn,
// Produit Sans Filtre, mentions légales. site-architecture.md, section Pages.
import { EMAIL, mailto } from '../utils/mail';

const liens = [
  { href: mailto(), label: EMAIL },
  { href: 'https://www.linkedin.com/in/julienbrionne', label: 'LinkedIn', externe: true },
  { href: 'https://produitsansfiltre.substack.com', label: 'Produit Sans Filtre', externe: true },
  { href: '/mentions-legales', label: 'Mentions légales' },
];
---

<footer class="mt-32 border-t border-line px-6 py-14 sm:mt-44 sm:px-10">
  <div class="shell flex flex-col gap-8 sm:flex-row sm:items-baseline sm:justify-between">
    <p class="wordmark text-base sm:text-lg">
      <span class="wordmark-given">Julien</span> <span class="wordmark-family">Brionne</span><span class="wordmark-dot">.</span>
    </p>
    <nav aria-label="Navigation de pied de page">
      <ul class="flex flex-col gap-3 text-sm sm:flex-row sm:flex-wrap sm:gap-8">
        {liens.map((lien) => (
          <li>
            <a href={lien.href} class="link-nav" rel={lien.externe ? 'noopener' : undefined}>{lien.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
