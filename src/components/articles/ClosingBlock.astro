---
import { slugify } from '../../utils/articles';
interface Props { title?: string; className?: string }
const { title, className = '' } = Astro.props;
const sectionId = title ? slugify(title) : '';
---

<section id={sectionId || undefined} class={`measure-wide border-t border-line pt-12 ${className}`}>
  {title && <h2 class="t-title mb-8 text-ink">{title}</h2>}
  <slot />
</section>
