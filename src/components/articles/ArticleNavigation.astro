---
// Navigation de bibliothèque : le texte précédent, le suivant. Deux liens.
interface ArticleLink { slug: string; title: string }
interface Props {
  previousArticle?: ArticleLink | null;
  nextArticle?: ArticleLink | null;
}
const { previousArticle, nextArticle } = Astro.props;
---

{(previousArticle || nextArticle) && (
  <nav class="mt-16 grid gap-8 border-t border-line pt-10 sm:grid-cols-2" aria-label="Autres textes">
    <div>
      {previousArticle && (
        <>
          <p class="mb-2 text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-dim">Texte précédent</p>
          <a href={`/articles/${previousArticle.slug}`} class="link-inline font-serif text-lg leading-snug">
            {previousArticle.title}
          </a>
        </>
      )}
    </div>
    <div class="sm:text-right">
      {nextArticle && (
        <>
          <p class="mb-2 text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-dim">Texte suivant</p>
          <a href={`/articles/${nextArticle.slug}`} class="link-inline font-serif text-lg leading-snug">
            {nextArticle.title}
          </a>
        </>
      )}
    </div>
  </nav>
)}
