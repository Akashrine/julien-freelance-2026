---
interface Props {
  title?: string;
  borderColor?: 'sand' | 'blue' | 'clay';
  className?: string;
}
const { title, className = '' } = Astro.props;
---

<div class={`my-12 max-w-[42rem] border-l-2 border-ochre pl-6 sm:pl-8 reveal ${className}`}>
  {title && <p class="eyebrow mb-3">{title}</p>}
  <slot />
</div>
