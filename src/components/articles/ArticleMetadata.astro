---
import { formatDate } from '../../utils/date';
import { getCategoryLabel, calculateReadingTime } from '../../utils/articles';

interface Props {
  date: string;
  category: string;
  readingTime?: number;
  content?: string; // Pour calculer le temps de lecture si readingTime n'est pas fourni
  variant?: 'list' | 'page';
}

const { date, category, readingTime, content, variant = 'page' } = Astro.props;

// Calculer le temps de lecture si nécessaire
const finalReadingTime = readingTime ?? (content ? calculateReadingTime(content) : undefined);

// Classes différentes selon la variante
const timeClasses = variant === 'list' 
  ? 'font-mono text-[#C5A070] block' 
  : 'font-mono text-[#C5A070] text-sm';
const categoryClasses = variant === 'list'
  ? 'font-mono text-[9px] text-gray-300'
  : 'font-mono text-[9px] text-gray-300';
const readingTimeClasses = variant === 'list'
  ? 'font-mono text-[9px] text-gray-400'
  : 'font-mono text-[9px] text-gray-400';
---

<div class="flex items-center gap-3 flex-wrap">
  <time datetime={date} class={timeClasses}>{formatDate(date)}</time>
  <span class={categoryClasses}>/ {getCategoryLabel(category)}</span>
  {finalReadingTime && (
    <span class={readingTimeClasses}>· ~{finalReadingTime} min{variant === 'page' ? ' de lecture' : ''}</span>
  )}
</div>
