---
interface Props { className?: string }
const { className = '' } = Astro.props;
---

<section class={`max-w-[42rem] mb-20 sm:mb-24 reveal ${className}`}>
  <slot />
</section>

<style>
  section :global(p:first-child) {
    font-size: 1.3125rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
  section :global(p:first-child::first-letter) {
    font-family: var(--font-serif);
    font-size: 3.4em;
    line-height: 0.85;
    float: left;
    padding-right: 0.14em;
    padding-top: 0.05em;
    color: var(--color-ink);
  }
</style>
