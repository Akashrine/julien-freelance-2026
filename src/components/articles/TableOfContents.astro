---
import type { TocHeading } from '../../utils/articles';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
---

{headings.length > 0 && (
  <nav aria-label="Table des matières" class="toc max-w-3xl mx-auto mb-16 py-8 border-y border-black/5">
    <p class="font-mono text-xs text-gray-400 tracking-widest uppercase mb-4">Sommaire</p>
    <ol class="space-y-2">
      {headings.map((h) => (
        <li>
          <a
            href={`#${h.id}`}
            class="font-mono text-sm text-gray-500 hover:text-gray-900 transition-colors leading-relaxed"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
