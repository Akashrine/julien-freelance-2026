---
import { slugify } from '../../utils/articles';
interface Props {
  bgColor?: 'blue' | 'clay';
  label?: string;
  title?: string;
  className?: string;
}
const { bgColor = 'blue', label, title, className = '' } = Astro.props;
const bg = bgColor === 'clay' ? 'article-color-block-clay' : 'article-color-block-blue';
const sectionId = slugify(label || title || '');
---

<section id={sectionId || undefined} class={`${bg} mb-20 px-6 py-14 sm:mb-24 sm:px-10 sm:py-20 reveal ${className}`}>
  <div class="max-w-[42rem]">
    {label && <p class="eyebrow mb-4">{label}</p>}
    {title && <h2 class="t-title mb-8 text-ink">{title}</h2>}
    <slot />
  </div>
</section>
