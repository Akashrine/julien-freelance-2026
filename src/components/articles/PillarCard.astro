---
// Ancienne carte. Devient un bloc typographique : titre serif, texte.
interface Props {
  title: string;
  description: string;
  blobColor?: 'blue' | 'clay' | 'sand';
  className?: string;
}
const { title, description, className = '' } = Astro.props;
---

<div class={`border-t border-line pt-5 reveal ${className}`}>
  <h3 class="mb-2 font-serif text-xl text-ink">{title}</h3>
  <p class="leading-relaxed text-dim">{description}</p>
</div>
