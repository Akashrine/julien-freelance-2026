---
// Section d'article : eyebrow + titre serif. Les ids restent, des liens
// peuvent pointer dessus.
import { slugify } from '../../utils/articles';
interface Props {
  label?: string;
  title?: string;
  quote?: string;
  maxWidth?: '2xl' | '3xl';
  titleSize?: 'default' | 'large';
  className?: string;
}
const { label, title, quote, className = '' } = Astro.props;
const sectionId = slugify(label || title || '');
---

<section id={sectionId || undefined} class={`max-w-[42rem] mb-20 sm:mb-24 reveal ${className}`}>
  {label && <p class="eyebrow mb-4">{label}</p>}
  {quote && (
    <p class="mb-8 font-serif text-xl italic leading-relaxed text-ink sm:text-2xl">
      “{quote}”
    </p>
  )}
  {title && <h2 class="t-sub mb-8 text-ink">{title}</h2>}
  <slot />
</section>
