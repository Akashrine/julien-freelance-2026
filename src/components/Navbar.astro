---
// Menu : Ce que je fais · Écrits. Le logo renvoie à /.
// Aucune autre entrée. site-architecture.md, section Navigation.
interface Props {
  current?: 'accueil' | 'ce-que-je-fais' | 'ecrits' | null;
}
const { current = null } = Astro.props;

const links = [
  { href: '/ce-que-je-fais', label: 'Ce que je fais', key: 'ce-que-je-fais' },
  { href: '/ecrits', label: 'Écrits', key: 'ecrits' },
];
---

<header class="w-full px-6 pt-10 sm:px-10 sm:pt-14">
  <div class="shell flex items-baseline justify-between gap-6 border-b border-line pb-6">
    <a href="/" class="wordmark text-xl transition-opacity hover:opacity-70 sm:text-2xl" aria-label="Julien Brionne, accueil">
      <span class="wordmark-given">Julien</span> <span class="wordmark-family">Brionne</span><span class="wordmark-dot">.</span>
    </a>

    <nav aria-label="Navigation principale">
      <ul class="flex items-baseline gap-6 text-sm sm:gap-10">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="link-nav"
              aria-current={current === link.key ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
