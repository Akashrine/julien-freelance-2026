---
// Menu : Ce que je fais · Écrits. Le logo renvoie à /.
// Aucune autre entrée. site-architecture.md, section Navigation.
interface Props {
  current?: 'accueil' | 'ce-que-je-fais' | 'ecrits' | null;
}
const { current = null } = Astro.props;

const links = [
  { href: '/ce-que-je-fais', label: 'Ce que je fais', key: 'ce-que-je-fais' },
  { href: '/ecrits', label: 'Écrits', key: 'ecrits' },
];
---

<header class="w-full px-6 pt-10 sm:px-10 sm:pt-14">
  <div class="shell flex items-baseline justify-between gap-6">
    <a href="/" class="wordmark text-lg transition-opacity hover:opacity-70 sm:text-xl" aria-label="Julien Brionne, accueil">
      <span class="wordmark-given">Julien</span> <span class="wordmark-family">Brionne</span><span class="wordmark-dot">.</span>
    </a>

    <nav aria-label="Navigation principale">
      <ul class="flex items-center gap-6 text-sm sm:gap-10">
        {links.map((link) => (
          <li class="flex">
            <a
              href={link.href}
              class="link-nav"
              aria-current={current === link.key ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li class="flex">
          <button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false" aria-label="Passer au thème sombre"></button>
        </li>
      </ul>
    </nav>

    <script>
      const bouton = document.getElementById('theme-toggle');
      const racine = document.documentElement;
      const prefereSombre = window.matchMedia('(prefers-color-scheme: dark)');

      const estSombre = () =>
        racine.dataset.theme === 'dark' ||
        (!racine.dataset.theme && prefereSombre.matches);

      // Le bouton dit où il emmène, pas où l'on est : c'est ce qu'annoncent
      // les lecteurs d'écran au moment de le déclencher.
      function annonce() {
        if (!bouton) return;
        const sombre = estSombre();
        bouton.setAttribute('aria-pressed', String(sombre));
        bouton.setAttribute('aria-label', sombre ? 'Passer au thème clair' : 'Passer au thème sombre');
      }

      if (bouton) {
        annonce();
        bouton.addEventListener('click', () => {
          const nouveau = estSombre() ? 'light' : 'dark';
          racine.dataset.theme = nouveau;
          try { localStorage.setItem('theme', nouveau); } catch (e) {}
          annonce();
        });
        // Tant qu'aucun choix n'est enregistré, le système fait foi.
        prefereSombre.addEventListener('change', () => {
          if (!racine.dataset.theme) annonce();
        });
      }
    </script>
  </div>
</header>
