---
// Le logotype « Julien Brionne. » — tracé vectoriel du logo dessiné
// (public/logo/), point final vermillon. 13/10/2026.
//
// Le nom vit dans un fichier externe, appelé par <use> : le navigateur le
// télécharge une fois et le garde en cache, au lieu de répéter 27 Ko de
// tracé dans chaque page. Il hérite de la couleur du texte (currentColor),
// donc du thème. Le point et le trait du survol restent dans la page pour
// prendre la couleur d'accent.
//
// `lien` : dans la navigation, le logo est le lien vers l'accueil et porte
// le geste du survol. Dans le pied de page, il ne réagit à rien.
interface Props {
  lien?: boolean;
  class?: string;
}
const { lien = false, class: classe = '' } = Astro.props;

// Repères du tracé (unités du viewBox) : nom de x 143 à 2858, ligne de base
// à y 459, point de 74 unités de diamètre — celui du i de « Julien ».
const VIEWBOX = '143 75 2803 427';
---

{lien ? (
  <a href="/" class:list={['wordmark', classe]} aria-label="Julien Brionne, accueil">
    <svg viewBox={VIEWBOX} aria-hidden="true" focusable="false">
      <rect class="wordmark-trait" x="143" y="540" width="2729" height="18" />
      <use href="/logo/julien-brionne-nom.svg#nom" />
      <circle class="wordmark-dot" cx="2909" cy="422" r="37" />
    </svg>
  </a>
) : (
  <p class:list={['wordmark', classe]}>
    <svg viewBox={VIEWBOX} role="img" aria-label="Julien Brionne">
      <use href="/logo/julien-brionne-nom.svg#nom" />
      <circle class="wordmark-dot" cx="2909" cy="422" r="37" />
    </svg>
  </p>
)}
