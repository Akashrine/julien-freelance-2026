---
---

<header class="relative min-h-[90vh] flex items-center overflow-hidden">
  <!-- Blobs décoratifs en fond avec halos -->
  <div class="blob blob-parallax w-[500px] h-[500px] bg-[#F2E9E1] top-[-10%] right-[-10%] organic-shape glow-sand"></div>
  <div class="blob blob-parallax w-[400px] h-[400px] bg-[#D7E5E5] bottom-[10%] left-[-5%] organic-shape glow-blue blob-delay-negative"></div>

  <!-- Halo lumineux central derrière le titre -->
  <div class="absolute top-[30%] left-[15%] w-[600px] h-[400px] halo-sand -z-10 opacity-70 pointer-events-none"></div>

  <!-- Courbes décoratives en fond -->
  <svg class="absolute bottom-0 left-0 w-full h-full pointer-events-none -z-10 opacity-50" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <!-- Courbe 1 (la plus haute et prononcée) -->
    <path d="M -100 750 Q 300 500, 600 400 Q 900 280, 1200 220 Q 1400 180, 1540 160" 
          stroke="#F2E9E1" 
          stroke-width="1.5" 
          fill="none" 
          stroke-linecap="round"
          opacity="0.6"/>
    <!-- Courbe 2 (milieu) -->
    <path d="M -50 800 Q 350 650, 700 550 Q 1000 450, 1300 380 Q 1450 330, 1540 300" 
          stroke="#D7E5E5" 
          stroke-width="1.2" 
          fill="none" 
          stroke-linecap="round"
          opacity="0.5"/>
    <!-- Courbe 3 (la plus basse) -->
    <path d="M 0 850 Q 400 750, 800 680 Q 1100 600, 1400 550 Q 1500 520, 1540 500" 
          stroke="#E5BAAD" 
          stroke-width="1" 
          fill="none" 
          stroke-linecap="round"
          opacity="0.4"/>
  </svg>

  <!-- Sphère décorative à droite avec glow -->
  <div class="absolute top-[20%] right-[8%] md:right-[12%] w-24 h-24 md:w-32 md:h-32 rounded-full bg-[#F2E9E1] opacity-40 -z-10 float blob-delay-1 glow-sand"></div>
  <!-- Petite sphère clay en bas à gauche -->
  <div class="absolute bottom-[15%] left-[5%] w-16 h-16 md:w-20 md:h-20 rounded-full bg-[#E5BAAD] opacity-25 -z-10 float" style="animation-delay: -3s;"></div>

  <div class="max-w-[1150px] mx-auto px-8 py-12 flex flex-col md:flex-row items-center gap-16 relative z-20 w-full">
    <div class="max-w-4xl relative z-20 flex-1">
      <div class="hero-label font-mono mb-8 text-gray-400 tracking-[0.2em] opacity-0">[ SENIOR PM. SCALE-UPS. ORGA PRODUIT. ]</div>
      <h1 class="hero-title hero-payoff text-5xl md:text-6xl lg:text-7xl leading-[1.08] mb-6 font-serif opacity-0">
        Ton orga produit<br>
        <span class="italic text-gray-800">ne suit plus</span><br>
        <span class="editorial-accent text-[0.7em]">ta croissance.</span>
      </h1>
      <p class="hero-text-1 max-w-2xl text-lg md:text-xl text-gray-700 leading-relaxed font-light mb-10 opacity-0">
        C'est là que j'interviens.
      </p>
      <p class="hero-text-2 max-w-2xl text-base md:text-lg text-gray-500 leading-relaxed font-light opacity-0">
        Senior PM, 10+ ans. Heetch, Back Market, Waalaxy, Wizville, et du conseil stratégique auprès de CEOs et founders.
      </p>
      <div class="mt-12 hero-cta opacity-0 flex items-center gap-6">
        <a href="/contact" class="btn-cta font-mono tracking-widest text-[10px]">Discuter de ta situation</a>
        <div class="editorial-rule"></div>
      </div>
    </div>
    
    <!-- Photo avec cadre organique décalé -->
    <div class="relative hero-image group opacity-0">
      <div class="w-72 md:w-80 h-[480px] overflow-hidden relative z-10 organic-shape shadow-2xl photo-hover-shadow transition-all duration-700 group-hover:scale-105">
        <picture>
          <source srcset="/_WOL6954-min.webp" type="image/webp" />
          <img
            src="/_WOL6954-min.jpg"
            alt="Julien Brionne, Senior PM Freelance"
            fetchpriority="high"
            width="320"
            height="480"
            class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110"
          />
        </picture>
      </div>
      <!-- Le cadre fin organique en dessous -->
      <div class="absolute -bottom-6 -left-6 w-full h-full border border-gray-200 -z-10 organic-shape transition-all duration-700 group-hover:-bottom-8 group-hover:-left-8 group-hover:border-gray-300"></div>
    </div>
  </div>
</header>
